{% extends 'base.html.twig' %}

{% block title %}Liste des Auteurs{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4 text-center">Liste des Auteurs</h1>

    {% if authors is defined and authors is not empty %}
        <table class="table table-striped table-hover">
            <thead class="table-dark text-center">
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for author in authors %}
                    <tr class="text-center align-middle">
                        <td><strong>{{ author.id }}</strong></td>
                        <td>{{ author.username|upper }}</td>
                        <td>{{ author.email }}</td>
                        <td>
                            <a href="{{ path('update_author', {'id': author.id}) }}" class="btn btn-warning btn-sm">
                                Modifier
                            </a>
                            <a href="{{ path('delete_author', {'id': author.id}) }}" 
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Voulez-vous vraiment supprimer cet auteur ?');">
                                Supprimer
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="mt-5">
            <h3>Statistiques</h3>
            <p><strong>Nombre total d'auteurs :</strong> {{ authors|length }}</p>
        </div>

    {% else %}
        <div class="alert alert-warning text-center" role="alert">
            Aucun auteur n’est disponible pour le moment.
        </div>
    {% endif %}
</div>
{% endblock %}
