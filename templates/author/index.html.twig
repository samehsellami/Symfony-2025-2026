
{% extends 'base.html.twig' %}

{% block title %}Liste des Auteurs{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Liste des Auteurs</h1>
        
        {# Condition pour vérifier si le tableau est défini et non vide #}
        {% if authors is defined and authors is not empty %}
            <div class="row">
                {% for author in authors %}
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <img src="{{ asset(author.picture) }}" 
                                 class="card-img-top" 
                                 alt="{{ author.username }}"
                                 style="height: 300px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title">
                                    {# Affichage du nom en majuscule #}
                                    {{ author.username|upper }}
                                </h5>
                                <p class="card-text">
                                    <strong>Email:</strong> {{ author.email }}<br>
                                    <strong>Nombre de livres:</strong> {{ author.nb_books }}
                                </p>
                                
                                {# Condition pour afficher un badge selon le nombre de livres #}
                                {% if author.nb_books > 200 %}
                                    <span class="badge bg-success">Auteur prolifique</span>
                                {% elseif author.nb_books > 100 %}
                                    <span class="badge bg-warning">Auteur actif</span>
                                {% else %}
                                    <span class="badge bg-info">Auteur</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            
            {# Statistiques #}
            <div class="mt-4">
                <h3>Statistiques</h3>
                <p>Nombre total d'auteurs: <strong>{{ authors|length }}</strong></p>
                <p>Nombre total de livres: <strong>{{ authors|map(a => a.nb_books)|reduce((sum, nb) => sum + nb) }}</strong></p>
            </div>
            
        {% else %}
            {# Message si le tableau est vide ou non défini #}
            <div class="alert alert-warning" role="alert">
                Aucun auteur n'est disponible pour le moment.
            </div>
        {% endif %}
    </div>
{% endblock %}