<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des Auteurs</title>
    <style>
        body { font-family: Arial; margin: 40px; }
        .author { 
            background: #f9f9f9; 
            padding: 15px; 
            margin: 10px 0; 
            border-left: 4px solid #3498db;
        }
        .author-name { 
            font-weight: bold; 
            color: #2c3e50; 
            margin-bottom: 5px;
        }
        .details-link {
            display: inline-block;
            background: #3498db;
            color: white;
            padding: 5px 10px;
            text-decoration: none;
            border-radius: 3px;
            margin-top: 10px;
        }
        .stats {
            background: #ecf0f1;
            padding: 15px;
            margin: 20px 0;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <h1>Liste des Auteurs</h1>
    
    {% if authors is defined and authors is not empty %}
        <!-- Point 6: Nombre des auteurs -->
        <!-- Point 7: Nombre total des livres -->
        <div class="stats">
            <strong>Nombre d'auteurs : {{ authors|length }}</strong><br>
            <strong>Nombre total de livres : 
                {% set totalBooks = 0 %}
                {% for author in authors %}
                    {% set totalBooks = totalBooks + author.nb_books %}
                {% endfor %}
                {{ totalBooks }}
            </strong>
        </div>

        {% for author in authors %}
            <div class="author">
                <div class="author-name">{{ author.username|upper }}</div>
                <div>Email: {{ author.email }}</div>
                <div>Nombre de livres: {{ author.nb_books }}</div>
                
                <!-- Point 8: Lien details -->
                <a href="{{ path('author_details', {'id': author.id}) }}" class="details-link">
                    Détails
                </a>
            </div>
        {% endfor %}
    {% else %}
        <p>Aucun auteur disponible.</p>
    {% endif %}
</body>
</html>